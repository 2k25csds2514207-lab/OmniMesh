datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  apiKeys       ApiKey[]
  conversations Conversation[]
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // 'openai' | 'anthropic' | 'gemini' | 'groq'
  encryptedKey String
  iv           String
  authTag      String
  last4        String
  label        String?  // Optional nickname like "Work Key" or "Personal"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Conversation {
  id             String          @id @default(uuid())
  userId         String
  title          String          @default("New Chat")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       Message[]
  comparisonRuns ComparisonRun[]

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String       // 'user' | 'assistant' | 'system'
  content        String
  model          String?      // e.g. 'gpt-4o', 'claude-3-5-sonnet', 'gemini-1.5-pro'
  provider       String?      // e.g. 'openai', 'anthropic', 'gemini'
  tokens         Int?         // Token count estimate
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ComparisonRun {
  id                 String       @id @default(uuid())
  conversationId     String
  promptMessageId    String
  responseMessageIds String       // JSON array of message IDs involved
  createdAt          DateTime     @default(now())

  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

